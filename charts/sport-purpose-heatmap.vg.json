{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Original funding-record counts by activity and purpose, with a square-root colour scale adapting to the selected year.",
  "data": {
    "url": "data/raw/active-clubs-records.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Project Funding Approved Date": "date:'%d/%m/%Y'",
        "Project Approved Funding $ (GST exclusive)": "number"
      }
    }
  },
  "width": "container",
  "height": 310,
  "params": [
    {
      "name": "selectedYear",
      "value": 2024,
      "bind": {
        "input": "select",
        "options": [
          2022,
          2023,
          2024
        ],
        "name": "Approval year: "
      }
    }
  ],
  "transform": [
    {
      "calculate": "year(datum[\"Project Funding Approved Date\"])",
      "as": "Year"
    },
    {
      "calculate": "datum[\"Project Funded Activity\"]",
      "as": "Activity"
    },
    {
      "calculate": "datum[\"Project Approved Funding $ (GST exclusive)\"]",
      "as": "Funding"
    },
    {
      "filter": "datum.Year == selectedYear"
    },
    {
      "calculate": "datum[\"Project Description\"]",
      "as": "Purpose"
    },
    {
      "aggregate": [
        {
          "op": "count",
          "as": "Records"
        }
      ],
      "groupby": [
        "Activity",
        "Purpose"
      ]
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "Records",
          "as": "ActivityTotal"
        }
      ],
      "groupby": [
        "Activity"
      ]
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "Records",
          "as": "PurposeTotal"
        }
      ],
      "groupby": [
        "Purpose"
      ]
    },
    {
      "window": [
        {
          "op": "dense_rank",
          "as": "ActivityRank"
        }
      ],
      "sort": [
        {
          "field": "ActivityTotal",
          "order": "descending"
        },
        {
          "field": "Activity",
          "order": "ascending"
        }
      ]
    },
    {
      "window": [
        {
          "op": "dense_rank",
          "as": "PurposeRank"
        }
      ],
      "sort": [
        {
          "field": "PurposeTotal",
          "order": "descending"
        },
        {
          "field": "Purpose",
          "order": "ascending"
        }
      ]
    },
    {
      "filter": "datum.ActivityRank <= 5 && datum.PurposeRank <= 5"
    },
    {
      "impute": "Records",
      "key": "Purpose",
      "groupby": [
        "Activity"
      ],
      "value": 0
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "Records",
          "as": "MaxCellRecords"
        }
      ]
    }
  ],
  "encoding": {
    "x": {
      "field": "Activity",
      "type": "nominal",
      "title": null,
      "sort": {
        "field": "ActivityTotal",
        "op": "max",
        "order": "descending"
      },
      "axis": {
        "labelAngle": -20,
        "labelLimit": 140
      }
    },
    "y": {
      "field": "Purpose",
      "type": "nominal",
      "title": null,
      "sort": {
        "field": "PurposeTotal",
        "op": "max",
        "order": "descending"
      },
      "axis": {
        "labelLimit": 315,
        "labelExpr": "replace(datum.label, /^(Deliver safe experiences|Supporting Volunteers|Provide flexible participation opportunities) - /, \"\")"
      }
    },
    "tooltip": [
      {
        "field": "Activity",
        "type": "nominal"
      },
      {
        "field": "Purpose",
        "type": "nominal",
        "title": "Original source purpose"
      },
      {
        "field": "Records",
        "type": "quantitative",
        "title": "Funding records",
        "format": ","
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 2
      },
      "encoding": {
        "color": {
          "field": "Records",
          "type": "quantitative",
          "scale": {
            "type": "sqrt",
            "zero": true,
            "nice": false,
            "range": [
              "#eff6f5",
              "#07585d"
            ]
          },
          "legend": {
            "title": "Funding records (square-root scale)",
            "orient": "bottom",
            "format": ",.0f",
            "titleLimit": 350,
            "gradientLength": 300
          }
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 15
      },
      "encoding": {
        "text": {
          "field": "Records",
          "type": "quantitative",
          "format": ","
        },
        "color": {
          "condition": {
            "test": "datum.MaxCellRecords > 0 && sqrt(datum.Records / datum.MaxCellRecords) > 0.65",
            "value": "white"
          },
          "value": "#132f3a"
        }
      }
    }
  ],
  "config": {
    "font": "Arial",
    "background": "white",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titlePadding": 12,
      "labelColor": "#354d58",
      "titleColor": "#354d58",
      "gridColor": "#e8eef1",
      "domain": false,
      "tickColor": "#cbd8de"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12
    }
  }
}
