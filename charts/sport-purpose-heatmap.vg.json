{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Heatmap of funding-purpose shares within leading activities. Each cell's colour represents its share of that activity's funding records. The four most frequent purposes across all years remain separate; all other purposes are grouped. Hover for counts and source labels. Shares are of records, not dollars or participants.",
  "data": {
    "url": "data/raw/active-clubs-records.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Project Funding Approved Date": "date:'%d/%m/%Y'",
        "Project Approved Funding $ (GST exclusive)": "number"
      }
    }
  },
  "width": "container",
  "height": {
    "step": 40
  },
  "params": [
    {
      "name": "selectedYear",
      "value": 2024,
      "bind": {
        "input": "select",
        "options": [
          2022,
          2023,
          2024
        ],
        "name": "Approval year: "
      }
    }
  ],
  "transform": [
    {
      "calculate": "year(datum[\"Project Funding Approved Date\"])",
      "as": "Year"
    },
    {
      "calculate": "datum[\"Project Funded Activity\"]",
      "as": "Activity"
    },
    {
      "calculate": "datum[\"Project Approved Funding $ (GST exclusive)\"]",
      "as": "Funding"
    },
    {
      "calculate": "datum[\"Project Description\"]",
      "as": "Purpose"
    },
    {
      "aggregate": [
        {
          "op": "count",
          "as": "Records"
        }
      ],
      "groupby": [
        "Year",
        "Activity",
        "Purpose"
      ]
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "Records",
          "as": "ActivityTotal"
        }
      ],
      "groupby": [
        "Year",
        "Activity"
      ]
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "Records",
          "as": "PurposeTotal"
        }
      ],
      "groupby": [
        "Purpose"
      ]
    },
    {
      "window": [
        {
          "op": "dense_rank",
          "as": "PurposeRank"
        }
      ],
      "sort": [
        {
          "field": "PurposeTotal",
          "order": "descending"
        },
        {
          "field": "Purpose",
          "order": "ascending"
        }
      ]
    },
    {
      "filter": "datum.Year == selectedYear"
    },
    {
      "window": [
        {
          "op": "dense_rank",
          "as": "ActivityRank"
        }
      ],
      "sort": [
        {
          "field": "ActivityTotal",
          "order": "descending"
        },
        {
          "field": "Activity",
          "order": "ascending"
        }
      ]
    },
    {
      "filter": "datum.ActivityRank <= 10"
    },
    {
      "calculate": "datum.PurposeRank <= 4 ? datum.Purpose : 'Other purposes'",
      "as": "PurposeGroup"
    },
    {
      "calculate": "datum.PurposeRank <= 4 ? datum.Purpose : 'Other recorded purposes'",
      "as": "OriginalPurpose"
    },
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "Records",
          "as": "Records"
        },
        {
          "op": "max",
          "field": "ActivityTotal",
          "as": "ActivityTotal"
        },
        {
          "op": "min",
          "field": "PurposeRank",
          "as": "PurposeOrder"
        }
      ],
      "groupby": [
        "Activity",
        "PurposeGroup",
        "OriginalPurpose"
      ]
    },
    {
      "calculate": "datum.Records / datum.ActivityTotal",
      "as": "Share"
    }
  ],
  "config": {
    "font": "Arial",
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 13,
      "titleFontSize": 14,
      "titlePadding": 12,
      "labelColor": "#354d58",
      "titleColor": "#354d58",
      "gridColor": "#e8eef1",
      "domain": false,
      "tickColor": "#cbd8de"
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "orient": "right",
      "direction": "vertical",
      "offset": 16
    }
  },
  "mark": {
    "type": "rect"
  },
  "encoding": {
    "x": {
      "field": "PurposeGroup",
      "type": "nominal",
      "sort": {
        "field": "PurposeOrder",
        "op": "min",
        "order": "ascending"
      },
      "title": null,
      "axis": {
        "labelAngle": -60,
        "labelAlign": "right",
        "labelLimit": 190,
        "labelPadding": 10,
        "labelExpr": "datum.label === \"Equipment - on field\" ? \"Field equipment\" : datum.label === \"Education and training for volunteers\" ? \"Volunteer training\" : datum.label === \"Equipment - off field\" ? \"Off-field equipment\" : datum.label === \"Deliver safe experiences - Equipment - on field\" ? \"On-field safety\" : datum.label"
      },
      "scale": {
        "padding": 0
      }
    },
    "y": {
      "field": "Activity",
      "type": "nominal",
      "sort": {
        "field": "ActivityTotal",
        "order": "descending",
        "op": "max"
      },
      "title": null,
      "axis": {
        "labelLimit": 240,
        "labelPadding": 10
      },
      "scale": {
        "padding": 0
      }
    },
    "color": {
      "field": "Share",
      "type": "quantitative",
      "title": "Share within activity",
      "scale": {
        "domain": [
          0,
          0.5,
          1
        ],
        "range": [
          "#dce8e6",
          "#78b2ad",
          "#087e83"
        ]
      },
      "legend": {
        "orient": "right",
        "direction": "vertical",
        "format": ".0%",
        "values": [
          0,
          0.25,
          0.5,
          0.75,
          1
        ],
        "offset": 16
      }
    },
    "tooltip": [
      {
        "field": "Activity",
        "title": "Activity"
      },
      {
        "field": "PurposeGroup",
        "title": "Funding purpose"
      },
      {
        "field": "OriginalPurpose",
        "title": "Source purpose"
      },
      {
        "field": "Records",
        "type": "quantitative",
        "format": ",.0f"
      },
      {
        "field": "ActivityTotal",
        "title": "All activity records",
        "type": "quantitative",
        "format": ",.0f"
      },
      {
        "field": "Share",
        "title": "Share within activity",
        "type": "quantitative",
        "format": ".1%"
      }
    ]
  }
}
