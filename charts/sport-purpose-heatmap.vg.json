{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Purpose mix within leading funded activities: each bar contains all records for that activity in the selected year. Four leading original purposes remain separate; all remaining purposes form Other purposes. Shares are of records, not dollars or participants.",
  "data": {
    "url": "data/raw/active-clubs-records.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Project Funding Approved Date": "date:'%d/%m/%Y'",
        "Project Approved Funding $ (GST exclusive)": "number"
      }
    }
  },
  "width": 350,
  "height": {
    "step": 48
  },
  "params": [
    {
      "name": "selectedYear",
      "value": 2024,
      "bind": {
        "input": "select",
        "options": [
          2022,
          2023,
          2024
        ],
        "name": "Approval year: "
      }
    },
    {
      "name": "topActivities",
      "value": 5,
      "bind": {
        "input": "select",
        "options": [
          5,
          10
        ],
        "name": "Leading activities: "
      }
    }
  ],
  "transform": [
    {
      "calculate": "year(datum[\"Project Funding Approved Date\"])",
      "as": "Year"
    },
    {
      "calculate": "datum[\"Project Funded Activity\"]",
      "as": "Activity"
    },
    {
      "calculate": "datum[\"Project Approved Funding $ (GST exclusive)\"]",
      "as": "Funding"
    },
    {
      "filter": "datum.Year == selectedYear"
    },
    {
      "calculate": "datum[\"Project Description\"]",
      "as": "Purpose"
    },
    {
      "aggregate": [
        {
          "op": "count",
          "as": "Records"
        }
      ],
      "groupby": [
        "Activity",
        "Purpose"
      ]
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "Records",
          "as": "ActivityTotal"
        }
      ],
      "groupby": [
        "Activity"
      ]
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "Records",
          "as": "PurposeTotal"
        }
      ],
      "groupby": [
        "Purpose"
      ]
    },
    {
      "window": [
        {
          "op": "dense_rank",
          "as": "ActivityRank"
        }
      ],
      "sort": [
        {
          "field": "ActivityTotal",
          "order": "descending"
        },
        {
          "field": "Activity",
          "order": "ascending"
        }
      ]
    },
    {
      "window": [
        {
          "op": "dense_rank",
          "as": "PurposeRank"
        }
      ],
      "sort": [
        {
          "field": "PurposeTotal",
          "order": "descending"
        },
        {
          "field": "Purpose",
          "order": "ascending"
        }
      ]
    },
    {
      "filter": "datum.ActivityRank <= topActivities"
    },
    {
      "calculate": "datum.PurposeRank <= 4 ? replace(datum.Purpose, /^(Deliver safe experiences|Supporting Volunteers|Provide flexible participation opportunities) - /, '') : 'Other purposes'",
      "as": "PurposeGroup"
    },
    {
      "calculate": "datum.PurposeRank <= 4 ? datum.Purpose : 'Other recorded purposes'",
      "as": "OriginalPurpose"
    },
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "Records",
          "as": "Records"
        },
        {
          "op": "max",
          "field": "ActivityTotal",
          "as": "ActivityTotal"
        },
        {
          "op": "min",
          "field": "PurposeRank",
          "as": "PurposeOrder"
        }
      ],
      "groupby": [
        "Activity",
        "PurposeGroup",
        "OriginalPurpose"
      ]
    },
    {
      "calculate": "datum.Records / datum.ActivityTotal",
      "as": "Share"
    }
  ],
  "config": {
    "font": "Arial",
    "background": "white",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 13,
      "titleFontSize": 14,
      "titlePadding": 12,
      "labelColor": "#354d58",
      "titleColor": "#354d58",
      "gridColor": "#e8eef1",
      "domain": false,
      "tickColor": "#cbd8de"
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "orient": "right",
      "direction": "vertical",
      "offset": 16
    }
  },
  "mark": {
    "type": "bar",
    "stroke": "white",
    "strokeWidth": 1
  },
  "encoding": {
    "y": {
      "field": "Activity",
      "type": "nominal",
      "sort": {
        "field": "ActivityTotal",
        "order": "descending",
        "op": "max"
      },
      "title": null,
      "axis": {
        "labelLimit": 200,
        "labelPadding": 10
      }
    },
    "x": {
      "field": "Share",
      "type": "quantitative",
      "stack": "zero",
      "title": "Share of activity records",
      "scale": {
        "domain": [
          0,
          1
        ]
      },
      "axis": {
        "format": ".0%",
        "tickCount": 5
      }
    },
    "color": {
      "field": "PurposeGroup",
      "type": "nominal",
      "scale": {
        "range": [
          "#187f83",
          "#e3aa45",
          "#5476a6",
          "#b86c46",
          "#abb8bf"
        ]
      },
      "legend": {
        "title": [
          "Purpose",
          "(four leading + other)"
        ],
        "orient": "right",
        "labelLimit": 0,
        "titleLimit": 0,
        "offset": 16,
        "labelExpr": "datum.label === \"Education and training for volunteers\" ? \"Volunteer training\" : datum.label === \"Participation activities and events\" ? \"Activities and events\" : datum.label === \"Resources for participation opportunities\" ? \"Participation resources\" : datum.label === \"Equipment - on field\" ? \"On-field equipment\" : datum.label === \"Equipment - off field\" ? \"Off-field equipment\" : datum.label"
      }
    },
    "order": {
      "field": "PurposeOrder",
      "type": "quantitative"
    },
    "tooltip": [
      {
        "field": "Activity"
      },
      {
        "field": "OriginalPurpose",
        "title": "Original source purpose"
      },
      {
        "field": "Records",
        "type": "quantitative",
        "format": ",.0f"
      },
      {
        "field": "ActivityTotal",
        "title": "All records for activity",
        "type": "quantitative",
        "format": ",.0f"
      },
      {
        "field": "Share",
        "type": "quantitative",
        "format": ".1%"
      }
    ]
  }
}
