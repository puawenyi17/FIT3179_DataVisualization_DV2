{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Spike map of estimated children. Triangle height is proportional to count using the shared scale shown beside both maps.",
  "width": 820,
  "height": 560,
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "maps/australia-states-2021.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#d8e2e6",
        "stroke": "white",
        "strokeWidth": 1.5
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 149.05,
            "lat": -35.45,
            "lon2": 153,
            "lat2": -38
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#71808a",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "lon2"
        },
        "latitude2": {
          "field": "lat2"
        }
      }
    },
    {
      "data": {
        "url": "data/processed/ausplay-state-children-participation-2022-23.csv",
        "format": {
          "type": "csv",
          "parse": {
            "estimate": "number",
            "participation_rate": "number"
          }
        }
      },
      "transform": [
        {
          "lookup": "state",
          "from": {
            "data": {
              "values": [
                {
                  "state": "WA",
                  "Longitude": 118,
                  "Latitude": -29
                },
                {
                  "state": "NT",
                  "Longitude": 133,
                  "Latitude": -23
                },
                {
                  "state": "SA",
                  "Longitude": 135,
                  "Latitude": -34
                },
                {
                  "state": "QLD",
                  "Longitude": 145.5,
                  "Latitude": -22.5
                },
                {
                  "state": "NSW",
                  "Longitude": 146,
                  "Latitude": -35
                },
                {
                  "state": "VIC",
                  "Longitude": 142,
                  "Latitude": -38.3
                },
                {
                  "state": "TAS",
                  "Longitude": 146.8,
                  "Latitude": -43
                },
                {
                  "state": "ACT",
                  "Longitude": 153,
                  "Latitude": -38
                }
              ]
            },
            "key": "state",
            "fields": [
              "Longitude",
              "Latitude"
            ]
          }
        },
        {
          "calculate": "datum.estimate / 2000000 * 160",
          "as": "SpikeHeight"
        },
        {
          "calculate": "'M -5,0 L 0,' + (-datum.SpikeHeight) + ' L 5,0 Z'",
          "as": "SpikePath"
        },
        {
          "calculate": "datum.state + ' · ' + format(datum.estimate, ',')",
          "as": "SpikeLabel"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 4,
        "opacity": 0.9,
        "color": "#276e86"
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "shape": {
          "field": "SpikePath",
          "type": "nominal",
          "scale": null,
          "legend": null
        },
        "tooltip": [
          {
            "field": "state_name",
            "type": "nominal",
            "title": "State / territory"
          },
          {
            "field": "estimate",
            "type": "quantitative",
            "format": ",",
            "title": "Estimated children (ages 0 to 14)"
          },
          {
            "field": "participation_rate",
            "type": "quantitative",
            "format": ".1%",
            "title": "Participation rate (1+ per year)"
          },
          {
            "field": "period",
            "type": "nominal",
            "title": "Reporting period"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/processed/ausplay-state-children-participation-2022-23.csv",
        "format": {
          "type": "csv",
          "parse": {
            "estimate": "number",
            "participation_rate": "number"
          }
        }
      },
      "transform": [
        {
          "lookup": "state",
          "from": {
            "data": {
              "values": [
                {
                  "state": "WA",
                  "Longitude": 118,
                  "Latitude": -29
                },
                {
                  "state": "NT",
                  "Longitude": 133,
                  "Latitude": -23
                },
                {
                  "state": "SA",
                  "Longitude": 135,
                  "Latitude": -34
                },
                {
                  "state": "QLD",
                  "Longitude": 145.5,
                  "Latitude": -22.5
                },
                {
                  "state": "NSW",
                  "Longitude": 146,
                  "Latitude": -35
                },
                {
                  "state": "VIC",
                  "Longitude": 142,
                  "Latitude": -38.3
                },
                {
                  "state": "TAS",
                  "Longitude": 146.8,
                  "Latitude": -43
                },
                {
                  "state": "ACT",
                  "Longitude": 153,
                  "Latitude": -38
                }
              ]
            },
            "key": "state",
            "fields": [
              "Longitude",
              "Latitude"
            ]
          }
        },
        {
          "calculate": "datum.estimate / 2000000 * 160",
          "as": "SpikeHeight"
        },
        {
          "calculate": "'M -5,0 L 0,' + (-datum.SpikeHeight) + ' L 5,0 Z'",
          "as": "SpikePath"
        },
        {
          "calculate": "datum.state + ' · ' + format(datum.estimate, ',')",
          "as": "SpikeLabel"
        }
      ],
      "mark": {
        "type": "text",
        "align": "center",
        "dy": 15,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#233c48",
        "baseline": "top"
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "SpikeLabel"
        },
        "tooltip": [
          {
            "field": "state_name",
            "type": "nominal",
            "title": "State / territory"
          },
          {
            "field": "estimate",
            "type": "quantitative",
            "format": ",",
            "title": "Estimated children (ages 0 to 14)"
          },
          {
            "field": "participation_rate",
            "type": "quantitative",
            "format": ".1%",
            "title": "Participation rate (1+ per year)"
          },
          {
            "field": "period",
            "type": "nominal",
            "title": "Reporting period"
          }
        ]
      }
    }
  ],
  "config": {
    "font": "Arial",
    "background": "white",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 13,
      "titleFontSize": 14
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 13
    }
  }
}
