{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Published 2024-25 gender percentages for PARC Full Access members only; no counts inferred.",
  "width": 520,
  "height": 335,
  "padding": {
    "top": 8,
    "left": 8,
    "right": 8,
    "bottom": 8
  },
  "autosize": {
    "type": "none",
    "contains": "content"
  },
  "background": "white",
  "signals": [
    {
      "name": "firstBoundary",
      "update": "length(data('source')) ? round(data('source')[0].Share * 100) : 0"
    },
    {
      "name": "secondBoundary",
      "update": "length(data('source')) > 1 ? round((data('source')[0].Share + data('source')[1].Share) * 100) : 0"
    }
  ],
  "data": [
    {
      "name": "source",
      "url": "data/processed/parc-membership-demographics.csv",
      "format": {
        "type": "csv",
        "parse": {
          "published_share_pct": "number"
        }
      },
      "transform": [
        {
          "type": "filter",
          "expr": "datum.financial_year === '2024-25' && datum.population_scope === 'Full Access members'"
        },
        {
          "type": "formula",
          "expr": "datum.gender",
          "as": "Category"
        },
        {
          "type": "formula",
          "expr": "datum.published_share_pct / 100",
          "as": "Share"
        },
        {
          "type": "formula",
          "expr": "datum.gender === 'Male' ? 0 : datum.gender === 'Female' ? 1 : 2",
          "as": "Order"
        },
        {
          "type": "collect",
          "sort": {
            "field": "Order"
          }
        }
      ]
    },
    {
      "name": "cells",
      "transform": [
        {
          "type": "sequence",
          "start": 0,
          "stop": 100,
          "as": "Cell"
        },
        {
          "type": "formula",
          "expr": "datum.Cell < firstBoundary ? 0 : datum.Cell < secondBoundary ? 1 : 2",
          "as": "Order"
        },
        {
          "type": "lookup",
          "from": "source",
          "key": "Order",
          "fields": [
            "Order"
          ],
          "values": [
            "Category",
            "Share"
          ],
          "as": [
            "Category",
            "Share"
          ]
        }
      ]
    }
  ],
  "marks": [
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "value": 0
          },
          "y": {
            "value": 27
          },
          "text": {
            "value": "Full Access members"
          },
          "fontSize": {
            "value": 25
          },
          "fill": {
            "value": "#173c4a"
          },
          "fontWeight": {
            "value": "bold"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "value": 0
          },
          "y": {
            "value": 53
          },
          "text": {
            "value": "Published gender shares, 2024–25"
          },
          "fontSize": {
            "value": 16
          },
          "fill": {
            "value": "#4d6068"
          }
        }
      }
    },
    {
      "name": "waffleCells",
      "type": "rect",
      "from": {
        "data": "cells"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "(datum.Cell % 10) * 24"
          },
          "y": {
            "signal": "78 + (9 - floor(datum.Cell / 10)) * 24"
          },
          "width": {
            "value": 21
          },
          "height": {
            "value": 21
          },
          "cornerRadius": {
            "value": 2
          },
          "fill": {
            "scale": "colour",
            "field": "Category"
          },
          "tooltip": {
            "signal": "{'Gender': datum.Category, 'Published share': format(datum.Share, '.0%'), 'Population': 'Full Access members only', 'Financial year': '2024-25', 'Note': 'One square = 1 percentage point; not one member.'}"
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "source"
      },
      "encode": {
        "update": {
          "x": {
            "value": 265
          },
          "y": {
            "signal": "87 + datum.Order * 76"
          },
          "width": {
            "value": 13
          },
          "height": {
            "value": 13
          },
          "fill": {
            "scale": "colour",
            "field": "Category"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "value": 288
          },
          "y": {
            "signal": "100 + datum.Order * 76 + 0"
          },
          "text": {
            "signal": "datum.Category"
          },
          "fontSize": {
            "value": 17
          },
          "fill": {
            "value": "#173c4a"
          },
          "fontWeight": {
            "value": "bold"
          }
        }
      },
      "from": {
        "data": "source"
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "value": 288
          },
          "y": {
            "signal": "100 + datum.Order * 76 + 27"
          },
          "text": {
            "signal": "format(datum.Share, '.0%')"
          },
          "fontSize": {
            "value": 16
          },
          "fill": {
            "value": "#173c4a"
          }
        }
      },
      "from": {
        "data": "source"
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "value": 0
          },
          "y": {
            "value": 333
          },
          "text": {
            "value": "Each square = 1 percentage point."
          },
          "fontSize": {
            "value": 14
          },
          "fill": {
            "value": "#4d6068"
          }
        }
      }
    }
  ],
  "config": {
    "text": {
      "font": "Arial"
    }
  },
  "scales": [
    {
      "name": "colour",
      "type": "ordinal",
      "domain": [
        "Male",
        "Female",
        "Non-binary"
      ],
      "range": [
        "#4267a5",
        "#087f87",
        "#99629f"
      ]
    }
  ]
}
