{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Published 2024-25 gender percentages for PARC Full Access members only; no counts inferred.",
  "width": 760,
  "height": 420,
  "padding": {
    "top": 8,
    "left": 8,
    "right": 8,
    "bottom": 8
  },
  "autosize": {
    "type": "none",
    "contains": "content"
  },
  "background": "transparent",
  "signals": [
    {
      "name": "firstBoundary",
      "update": "length(data('source')) ? round(data('source')[0].Share * 100) : 0"
    },
    {
      "name": "secondBoundary",
      "update": "length(data('source')) > 1 ? round((data('source')[0].Share + data('source')[1].Share) * 100) : 0"
    }
  ],
  "data": [
    {
      "name": "source",
      "url": "data/processed/parc-membership-demographics.csv",
      "format": {
        "type": "csv",
        "parse": {
          "published_share_pct": "number"
        }
      },
      "transform": [
        {
          "type": "filter",
          "expr": "datum.financial_year === '2024-25' && datum.population_scope === 'Full Access members'"
        },
        {
          "type": "formula",
          "expr": "datum.gender",
          "as": "Category"
        },
        {
          "type": "formula",
          "expr": "datum.published_share_pct / 100",
          "as": "Share"
        },
        {
          "type": "formula",
          "expr": "datum.gender === 'Male' ? 0 : datum.gender === 'Female' ? 1 : 2",
          "as": "Order"
        },
        {
          "type": "collect",
          "sort": {
            "field": "Order"
          }
        }
      ]
    },
    {
      "name": "cells",
      "transform": [
        {
          "type": "sequence",
          "start": 0,
          "stop": 100,
          "as": "Cell"
        },
        {
          "type": "formula",
          "expr": "datum.Cell < firstBoundary ? 0 : datum.Cell < secondBoundary ? 1 : 2",
          "as": "Order"
        },
        {
          "type": "lookup",
          "from": "source",
          "key": "Order",
          "fields": [
            "Order"
          ],
          "values": [
            "Category",
            "Share"
          ],
          "as": [
            "Category",
            "Share"
          ]
        },
        {
          "type": "formula",
          "expr": "(datum.Cell % 10) * 29 + 13",
          "as": "CenterX"
        },
        {
          "type": "formula",
          "expr": "80 + (9 - floor(datum.Cell / 10)) * 29 + 13",
          "as": "CenterY"
        }
      ]
    },
    {
      "name": "categoryLabels",
      "source": "cells",
      "transform": [
        {
          "type": "aggregate",
          "groupby": ["Category", "Order"],
          "fields": ["CenterX", "CenterY", "Share"],
          "ops": ["mean", "mean", "max"],
          "as": ["CenterX", "CenterY", "Share"]
        },
        {
          "type": "filter",
          "expr": "datum.Share >= 0.05"
        }
      ]
    }
  ],
  "marks": [
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "value": 0
          },
          "y": {
            "value": 27
          },
          "text": {
            "value": "Full Access members"
          },
          "fontSize": {
            "value": 25
          },
          "fill": {
            "value": "#173c4a"
          },
          "fontWeight": {
            "value": "bold"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "value": 0
          },
          "y": {
            "value": 53
          },
          "text": {
            "value": "Published gender shares, 2024–25"
          },
          "fontSize": {
            "value": 16
          },
          "fill": {
            "value": "#4d6068"
          }
        }
      }
    },
    {
      "name": "waffleCells",
      "type": "rect",
      "from": {
        "data": "cells"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "(datum.Cell % 10) * 29"
          },
          "y": {
            "signal": "80 + (9 - floor(datum.Cell / 10)) * 29"
          },
          "width": {
            "value": 26
          },
          "height": {
            "value": 26
          },
          "cornerRadius": {
            "value": 2
          },
          "fill": {
            "scale": "colour",
            "field": "Category"
          },
          "tooltip": {
            "signal": "{'Gender': datum.Category, 'Published share': format(datum.Share, '.0%'), 'Population': 'Full Access members only', 'Financial year': '2024-25', 'Note': 'One square = 1 percentage point; not one member.'}"
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {"data": "categoryLabels"},
      "encode": {
        "update": {
          "x": {"signal": "datum.CenterX - 26"},
          "y": {"signal": "datum.CenterY - 13"},
          "width": {"value": 52},
          "height": {"value": 26},
          "cornerRadius": {"value": 6},
          "fill": {"value": "#ffffff"},
          "fillOpacity": {"value": 0.96},
          "stroke": {"value": "#173c4a"},
          "strokeOpacity": {"value": 0.18},
          "strokeWidth": {"value": 1}
        }
      }
    },
    {
      "type": "text",
      "from": {"data": "categoryLabels"},
      "encode": {
        "update": {
          "x": {"field": "CenterX"},
          "y": {"field": "CenterY"},
          "text": {"signal": "format(datum.Share, '.0%')"},
          "align": {"value": "center"},
          "baseline": {"value": "middle"},
          "fontSize": {"value": 16},
          "fontWeight": {"value": "bold"},
          "fill": {"value": "#173c4a"}
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "source"
      },
      "encode": {
        "update": {
          "x": {
          "value": 420
          },
          "y": {
            "signal": "87 + datum.Order * 84"
          },
          "width": {
            "value": 16
          },
          "height": {
            "value": 16
          },
          "fill": {
            "scale": "colour",
            "field": "Category"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "value": 445
          },
          "y": {
            "signal": "100 + datum.Order * 84"
          },
          "text": {
            "signal": "datum.Category"
          },
          "fontSize": {
            "value": 19
          },
          "fill": {
            "value": "#173c4a"
          },
          "fontWeight": {
            "value": "bold"
          }
        }
      },
      "from": {
        "data": "source"
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "value": 445
          },
          "y": {
            "signal": "100 + datum.Order * 84 + 30"
          },
          "text": {
            "signal": "format(datum.Share, '.0%')"
          },
          "fontSize": {
            "value": 17
          },
          "fill": {
            "value": "#173c4a"
          }
        }
      },
      "from": {
        "data": "source"
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "value": 0
          },
          "y": {
          "value": 395
          },
          "text": {
            "value": "Each square = 1 percentage point."
          },
          "fontSize": {
            "value": 14
          },
          "fill": {
            "value": "#4d6068"
          }
        }
      }
    }
  ],
  "config": {
    "text": {
      "font": "Arial"
    }
  },
  "scales": [
    {
      "name": "colour",
      "type": "ordinal",
      "domain": [
        "Male",
        "Female",
        "Non-binary"
      ],
      "range": [
        "#187f83",
        "#c56329",
        "#99629f"
      ]
    }
  ]
}
