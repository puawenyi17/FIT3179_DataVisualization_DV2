{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Diverging lollipop chart of percentage change in reported football participant counts relative to 2022, by region, gender and selected age group/year. Not population participation rates.",
  "data": {
    "url": "data/raw/football-sunburst-counts-2022-2025.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Year": "number",
        "Participants": "number",
        "AgeGroupTotal": "number",
        "SourcePage": "number"
      }
    }
  },
  "params": [
    {
      "name": "selectedFootballAge",
      "value": "Youth",
      "bind": {
        "input": "select",
        "options": [
          "MiniRoos",
          "Youth",
          "Senior"
        ],
        "name": "Age group: "
      }
    },
    {
      "name": "selectedFootballYear",
      "value": 2025,
      "bind": {
        "input": "select",
        "options": [
          2023,
          2024,
          2025
        ],
        "name": "Compare 2022 with: "
      }
    }
  ],
  "transform": [
    {
      "calculate": "datum.Year === 2022 ? datum.Participants : null",
      "as": "BaselineInput"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "BaselineInput",
          "as": "Baseline"
        }
      ],
      "groupby": [
        "Region",
        "AgeGroup",
        "Gender"
      ]
    },
    {
      "calculate": "datum.Baseline > 0 ? datum.Participants / datum.Baseline - 1 : null",
      "as": "Growth"
    },
    {
      "calculate": "datum.Growth < 0 ? 'Decrease' : 'Increase or unchanged'",
      "as": "Direction"
    },
    {
      "filter": "datum.AgeGroup === selectedFootballAge && datum.Year === selectedFootballYear && isValid(datum.Growth)"
    }
  ],
  "facet": {
    "column": {
      "field": "Gender",
      "type": "nominal",
      "sort": [
        "Male",
        "Female"
      ],
      "title": null,
      "header": {
        "labelFontSize": 18,
        "labelFontWeight": "bold"
      }
    }
  },
  "spacing": 36,
  "spec": {
    "width": 330,
    "height": 350,
    "layer": [
      {
        "data": {
          "values": [
            {}
          ]
        },
        "mark": {
          "type": "rule",
          "color": "#81959d",
          "strokeWidth": 1.2
        },
        "encoding": {
          "x": {
            "datum": 0,
            "type": "quantitative"
          }
        }
      },
      {
        "mark": {
          "type": "rule",
          "strokeWidth": 2.5
        },
        "encoding": {
          "x": {
            "field": "Growth",
            "type": "quantitative",
            "title": "Change from 2022",
            "scale": {
              "domain": [
                -0.5,
                {
                  "expr": "selectedFootballAge === 'MiniRoos' ? 1.8 : selectedFootballAge === 'Youth' ? 1 : 0.7"
                }
              ],
              "nice": false
            },
            "axis": {
              "format": ".0%",
              "tickCount": 6,
              "grid": true,
              "labelOverlap": false
            }
          },
          "x2": {
            "datum": 0
          },
          "y": {
            "field": "Region",
            "type": "nominal",
            "sort": [
              "NSW",
              "Northern NSW",
              "VIC",
              "QLD",
              "WA",
              "SA",
              "ACT",
              "TAS",
              "NT"
            ],
            "title": null,
            "axis": {
              "labelPadding": 8,
              "grid": false
            }
          },
          "color": {
            "field": "Direction",
            "type": "nominal",
            "scale": {
              "domain": [
                "Increase or unchanged",
                "Decrease"
              ],
              "range": [
                "#187f83",
                "#c56329"
              ]
            },
            "legend": {
              "title": null,
              "orient": "bottom",
              "labelLimit": 220
            }
          },
          "tooltip": [
            {
              "field": "Region",
              "type": "nominal",
              "title": "Reporting region"
            },
            {
              "field": "AgeGroup",
              "type": "nominal",
              "title": "Age group"
            },
            {
              "field": "Gender",
              "type": "nominal"
            },
            {
              "field": "Year",
              "type": "ordinal",
              "title": "Comparison year"
            },
            {
              "field": "Participants",
              "type": "quantitative",
              "format": ",",
              "title": "Participants in selected year"
            },
            {
              "field": "Baseline",
              "type": "quantitative",
              "format": ",",
              "title": "Participants in 2022"
            },
            {
              "field": "Growth",
              "type": "quantitative",
              "format": "+.1%",
              "title": "Change from 2022"
            },
            {
              "field": "SourcePage",
              "type": "quantitative",
              "title": "Selected-year report page"
            }
          ]
        }
      },
      {
        "mark": {
          "type": "point",
          "filled": true,
          "size": 105,
          "stroke": "white",
          "strokeWidth": 0.8
        },
        "encoding": {
          "x": {
            "field": "Growth",
            "type": "quantitative",
            "title": "Change from 2022",
            "scale": {
              "domain": [
                -0.5,
                {
                  "expr": "selectedFootballAge === 'MiniRoos' ? 1.8 : selectedFootballAge === 'Youth' ? 1 : 0.7"
                }
              ],
              "nice": false
            },
            "axis": {
              "format": ".0%",
              "tickCount": 6,
              "grid": true,
              "labelOverlap": false
            }
          },
          "y": {
            "field": "Region",
            "type": "nominal",
            "sort": [
              "NSW",
              "Northern NSW",
              "VIC",
              "QLD",
              "WA",
              "SA",
              "ACT",
              "TAS",
              "NT"
            ],
            "title": null,
            "axis": {
              "labelPadding": 8,
              "grid": false
            }
          },
          "color": {
            "field": "Direction",
            "type": "nominal",
            "scale": {
              "domain": [
                "Increase or unchanged",
                "Decrease"
              ],
              "range": [
                "#187f83",
                "#c56329"
              ]
            },
            "legend": {
              "title": null,
              "orient": "bottom",
              "labelLimit": 220
            }
          },
          "tooltip": [
            {
              "field": "Region",
              "type": "nominal",
              "title": "Reporting region"
            },
            {
              "field": "AgeGroup",
              "type": "nominal",
              "title": "Age group"
            },
            {
              "field": "Gender",
              "type": "nominal"
            },
            {
              "field": "Year",
              "type": "ordinal",
              "title": "Comparison year"
            },
            {
              "field": "Participants",
              "type": "quantitative",
              "format": ",",
              "title": "Participants in selected year"
            },
            {
              "field": "Baseline",
              "type": "quantitative",
              "format": ",",
              "title": "Participants in 2022"
            },
            {
              "field": "Growth",
              "type": "quantitative",
              "format": "+.1%",
              "title": "Change from 2022"
            },
            {
              "field": "SourcePage",
              "type": "quantitative",
              "title": "Selected-year report page"
            }
          ]
        }
      },
      {
        "mark": {
          "type": "text",
          "align": {
            "expr": "datum.Growth < 0 ? 'right' : 'left'"
          },
          "dx": {
            "expr": "datum.Growth < 0 ? -9 : 9"
          },
          "fontSize": 11,
          "color": "#233c48"
        },
        "encoding": {
          "x": {
            "field": "Growth",
            "type": "quantitative",
            "title": "Change from 2022",
            "scale": {
              "domain": [
                -0.5,
                {
                  "expr": "selectedFootballAge === 'MiniRoos' ? 1.8 : selectedFootballAge === 'Youth' ? 1 : 0.7"
                }
              ],
              "nice": false
            },
            "axis": {
              "format": ".0%",
              "tickCount": 6,
              "grid": true,
              "labelOverlap": false
            }
          },
          "y": {
            "field": "Region",
            "type": "nominal",
            "sort": [
              "NSW",
              "Northern NSW",
              "VIC",
              "QLD",
              "WA",
              "SA",
              "ACT",
              "TAS",
              "NT"
            ],
            "title": null,
            "axis": {
              "labelPadding": 8,
              "grid": false
            }
          },
          "text": {
            "field": "Growth",
            "type": "quantitative",
            "format": "+.1%"
          },
          "tooltip": [
            {
              "field": "Region",
              "type": "nominal",
              "title": "Reporting region"
            },
            {
              "field": "AgeGroup",
              "type": "nominal",
              "title": "Age group"
            },
            {
              "field": "Gender",
              "type": "nominal"
            },
            {
              "field": "Year",
              "type": "ordinal",
              "title": "Comparison year"
            },
            {
              "field": "Participants",
              "type": "quantitative",
              "format": ",",
              "title": "Participants in selected year"
            },
            {
              "field": "Baseline",
              "type": "quantitative",
              "format": ",",
              "title": "Participants in 2022"
            },
            {
              "field": "Growth",
              "type": "quantitative",
              "format": "+.1%",
              "title": "Change from 2022"
            },
            {
              "field": "SourcePage",
              "type": "quantitative",
              "title": "Selected-year report page"
            }
          ]
        }
      }
    ]
  },
  "resolve": {
    "scale": {
      "x": "shared",
      "y": "shared",
      "color": "shared"
    }
  },
  "config": {
    "font": "Arial",
    "background": "white",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titlePadding": 12,
      "labelColor": "#354d58",
      "titleColor": "#354d58",
      "gridColor": "#e8eef1",
      "domain": false,
      "tickColor": "#cbd8de"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12
    }
  }
}
