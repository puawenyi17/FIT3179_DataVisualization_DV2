{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Grouped lollipop chart comparing male and female football participation growth within each reporting region. Position and stem length show percentage change since 2022; colour shows gender; circle area shows selected-year Participants for the selected age group, on a fixed shared linear size scale. Counts are not population participation rates.",
  "data": {
    "url": "data/raw/football-sunburst-counts-2022-2025.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Year": "number",
        "Participants": "number",
        "AgeGroupTotal": "number",
        "SourcePage": "number"
      }
    }
  },
  "params": [
    {
      "name": "selectedFootballAge",
      "value": "Youth",
      "bind": {
        "input": "select",
        "options": [
          "MiniRoos",
          "Youth",
          "Senior"
        ],
        "name": "Age group: "
      }
    },
    {
      "name": "selectedFootballYear",
      "value": 2025,
      "bind": {
        "input": "select",
        "options": [
          2023,
          2024,
          2025
        ],
        "name": "Compare 2022 with: "
      }
    }
  ],
  "transform": [
    {
      "calculate": "datum.Year === 2022 ? datum.Participants : null",
      "as": "BaselineInput"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "BaselineInput",
          "as": "Baseline"
        }
      ],
      "groupby": [
        "Region",
        "AgeGroup",
        "Gender"
      ]
    },
    {
      "calculate": "datum.Baseline > 0 ? datum.Participants / datum.Baseline - 1 : null",
      "as": "Growth"
    },
    {
      "filter": "datum.AgeGroup === selectedFootballAge && datum.Year === selectedFootballYear && isValid(datum.Growth)"
    },
    {
      "calculate": "indexof([\"NSW\", \"Northern NSW\", \"VIC\", \"QLD\", \"WA\", \"SA\", \"ACT\", \"TAS\", \"NT\"], datum.Region) * 2 + (datum.Gender === \"Male\" ? 0 : 1)",
      "as": "GenderRow"
    }
  ],
  "config": {
    "font": "Arial",
    "background": "white",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 13,
      "titleFontSize": 14,
      "titlePadding": 12,
      "labelColor": "#354d58",
      "titleColor": "#354d58",
      "gridColor": "#e8eef1",
      "domain": false,
      "tickColor": "#cbd8de"
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "orient": "right",
      "direction": "vertical",
      "offset": 16
    }
  },
  "width": 760,
  "height": 720,
  "layer": [
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#81959d",
        "strokeWidth": 1.2
      },
      "encoding": {
        "x": {
          "datum": 0,
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 2.5
      },
      "encoding": {
        "x": {
          "field": "Growth",
          "type": "quantitative",
          "title": "Change from 2022",
          "scale": {
            "domain": [
              -0.5,
              {
                "expr": "selectedFootballAge === 'MiniRoos' ? 1.8 : selectedFootballAge === 'Youth' ? 1 : 0.7"
              }
            ],
            "nice": false
          },
          "axis": {
            "format": ".0%",
            "tickCount": 6,
            "grid": true,
            "labelOverlap": false
          }
        },
        "x2": {
          "datum": 0
        },
        "y": {
          "field": "GenderRow",
          "type": "quantitative",
          "scale": {
            "domain": [
              17.5,
              -0.5
            ],
            "nice": false
          },
          "axis": {
            "title": null,
            "values": [
              0.5,
              2.5,
              4.5,
              6.5,
              8.5,
              10.5,
              12.5,
              14.5,
              16.5
            ],
            "labelExpr": "[\"NSW\", \"Northern NSW\", \"VIC\", \"QLD\", \"WA\", \"SA\", \"ACT\", \"TAS\", \"NT\"][floor(datum.value / 2)]",
            "labelPadding": 12,
            "grid": false,
            "ticks": false,
            "labelLimit": 0
          }
        },
        "color": {
          "field": "Gender",
          "type": "nominal",
          "scale": {
            "domain": [
              "Male",
              "Female"
            ],
            "range": [
              "#187f83",
              "#c56329"
            ]
          },
          "legend": {
            "title": "Gender",
            "orient": "right",
            "direction": "vertical",
            "offset": 16
          }
        },
        "tooltip": [
          {
            "field": "Region",
            "type": "nominal",
            "title": "Reporting region"
          },
          {
            "field": "AgeGroup",
            "type": "nominal",
            "title": "Age group"
          },
          {
            "field": "Gender",
            "type": "nominal"
          },
          {
            "field": "Year",
            "type": "ordinal",
            "title": "Comparison year"
          },
          {
            "field": "Participants",
            "type": "quantitative",
            "format": ",.0f",
            "title": "Participants in selected year"
          },
          {
            "field": "Baseline",
            "type": "quantitative",
            "format": ",.0f",
            "title": "Participants in 2022"
          },
          {
            "field": "Growth",
            "type": "quantitative",
            "format": "+.1%",
            "title": "Change from 2022"
          },
          {
            "field": "SourcePage",
            "type": "quantitative",
            "title": "Selected-year report page"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "stroke": "white",
        "strokeWidth": 0.8,
        "opacity": 0.9
      },
      "encoding": {
        "x": {
          "field": "Growth",
          "type": "quantitative",
          "title": "Change from 2022",
          "scale": {
            "domain": [
              -0.5,
              {
                "expr": "selectedFootballAge === 'MiniRoos' ? 1.8 : selectedFootballAge === 'Youth' ? 1 : 0.7"
              }
            ],
            "nice": false
          },
          "axis": {
            "format": ".0%",
            "tickCount": 6,
            "grid": true,
            "labelOverlap": false
          }
        },
        "y": {
          "field": "GenderRow",
          "type": "quantitative",
          "scale": {
            "domain": [
              17.5,
              -0.5
            ],
            "nice": false
          },
          "axis": {
            "title": null,
            "values": [
              0.5,
              2.5,
              4.5,
              6.5,
              8.5,
              10.5,
              12.5,
              14.5,
              16.5
            ],
            "labelExpr": "[\"NSW\", \"Northern NSW\", \"VIC\", \"QLD\", \"WA\", \"SA\", \"ACT\", \"TAS\", \"NT\"][floor(datum.value / 2)]",
            "labelPadding": 12,
            "grid": false,
            "ticks": false,
            "labelLimit": 0
          }
        },
        "color": {
          "field": "Gender",
          "type": "nominal",
          "scale": {
            "domain": [
              "Male",
              "Female"
            ],
            "range": [
              "#187f83",
              "#c56329"
            ]
          },
          "legend": {
            "title": "Gender",
            "orient": "right",
            "direction": "vertical",
            "offset": 16
          }
        },
        "tooltip": [
          {
            "field": "Region",
            "type": "nominal",
            "title": "Reporting region"
          },
          {
            "field": "AgeGroup",
            "type": "nominal",
            "title": "Age group"
          },
          {
            "field": "Gender",
            "type": "nominal"
          },
          {
            "field": "Year",
            "type": "ordinal",
            "title": "Comparison year"
          },
          {
            "field": "Participants",
            "type": "quantitative",
            "format": ",.0f",
            "title": "Participants in selected year"
          },
          {
            "field": "Baseline",
            "type": "quantitative",
            "format": ",.0f",
            "title": "Participants in 2022"
          },
          {
            "field": "Growth",
            "type": "quantitative",
            "format": "+.1%",
            "title": "Change from 2022"
          },
          {
            "field": "SourcePage",
            "type": "quantitative",
            "title": "Selected-year report page"
          }
        ],
        "size": {
          "field": "Participants",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "domain": [
              0,
              100000
            ],
            "range": [
              0,
              640
            ],
            "zero": true,
            "nice": false
          },
          "legend": {
            "title": [
              "Participants in",
              "selected year"
            ],
            "orient": "right",
            "direction": "vertical",
            "offset": 16,
            "values": [
              1000,
              10000,
              50000,
              100000
            ],
            "format": ",.0f",
            "symbolFillColor": "#8b9fa8",
            "symbolStrokeColor": "white",
            "labelLimit": 180
          }
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": {
          "expr": "datum.Growth < 0 ? 'right' : 'left'"
        },
        "dx": {
          "expr": "(datum.Growth < 0 ? -1 : 1) * (sqrt(datum.Participants / 100000 * 640) / 2 + 8)"
        },
        "fontSize": 12,
        "color": "#233c48"
      },
      "encoding": {
        "x": {
          "field": "Growth",
          "type": "quantitative",
          "title": "Change from 2022",
          "scale": {
            "domain": [
              -0.5,
              {
                "expr": "selectedFootballAge === 'MiniRoos' ? 1.8 : selectedFootballAge === 'Youth' ? 1 : 0.7"
              }
            ],
            "nice": false
          },
          "axis": {
            "format": ".0%",
            "tickCount": 6,
            "grid": true,
            "labelOverlap": false
          }
        },
        "y": {
          "field": "GenderRow",
          "type": "quantitative",
          "scale": {
            "domain": [
              17.5,
              -0.5
            ],
            "nice": false
          },
          "axis": {
            "title": null,
            "values": [
              0.5,
              2.5,
              4.5,
              6.5,
              8.5,
              10.5,
              12.5,
              14.5,
              16.5
            ],
            "labelExpr": "[\"NSW\", \"Northern NSW\", \"VIC\", \"QLD\", \"WA\", \"SA\", \"ACT\", \"TAS\", \"NT\"][floor(datum.value / 2)]",
            "labelPadding": 12,
            "grid": false,
            "ticks": false,
            "labelLimit": 0
          }
        },
        "text": {
          "field": "Growth",
          "type": "quantitative",
          "format": "+.1%"
        },
        "tooltip": [
          {
            "field": "Region",
            "type": "nominal",
            "title": "Reporting region"
          },
          {
            "field": "AgeGroup",
            "type": "nominal",
            "title": "Age group"
          },
          {
            "field": "Gender",
            "type": "nominal"
          },
          {
            "field": "Year",
            "type": "ordinal",
            "title": "Comparison year"
          },
          {
            "field": "Participants",
            "type": "quantitative",
            "format": ",.0f",
            "title": "Participants in selected year"
          },
          {
            "field": "Baseline",
            "type": "quantitative",
            "format": ",.0f",
            "title": "Participants in 2022"
          },
          {
            "field": "Growth",
            "type": "quantitative",
            "format": "+.1%",
            "title": "Change from 2022"
          },
          {
            "field": "SourcePage",
            "type": "quantitative",
            "title": "Selected-year report page"
          }
        ]
      }
    }
  ]
}
